{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>tuxpeople/shared//renovate/renovate.json5",
    "github>tuxpeople/shared//renovate/minimumReleaseAge.json5"
  ],
  "suppressNotifications": [
    "prEditedNotification",
    "prIgnoreNotification"
  ],
  "rebaseWhen": "conflicted",
  "packageRules": [
    {
      "description": "oc from the OpenShift mirror (debugcontainer): stay on 4.x",
      "matchDatasources": [
        "custom.openshift-ocp"
      ],
      "extractVersion": "^/?(?<version>\\d+\\.\\d+\\.\\d+)/?$",
      "allowedVersions": "<5"
    }
  ],
  "customDatasources": {
    "openshift-ocp": {
      "defaultRegistryUrlTemplate": "https://mirror.openshift.com/pub/openshift-v4/clients/ocp/",
      "format": "html"
    }
  }
}
